# Server-only local PostgreSQL connection; replace placeholders locally.
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/resource_reservation_db?schema=public"

# Required in development and production. Generate a fresh secret locally with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Never commit the generated value or use a NEXT_PUBLIC_ prefix.
AUTH_SECRET=""

# Required on production/Vercel. HTTPS Upstash-compatible Redis REST endpoint
# and a server-only standard token with EVAL/INCR/PEXPIRE permissions.
# If missing or unavailable, login and account mutations fail closed there.
RATE_LIMIT_REDIS_REST_URL=""
RATE_LIMIT_REDIS_REST_TOKEN=""

# Optional integration-test target: a SEPARATE database whose name ends in _test.
# Apply reviewed migrations to this test database first. Never use the main DB.
TEST_DATABASE_URL=""

# Vercel Blob object storage token for resource photographs.
# In production on Vercel: Automatically provided when linking a Vercel Blob store.
# In local development: Obtain from Vercel Project Settings > Storage > Blob Read/Write Token.
# When omitted locally, image uploads fail gracefully with descriptive 503 notifications.
BLOB_READ_WRITE_TOKEN=""
